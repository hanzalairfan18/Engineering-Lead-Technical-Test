# --- Server -------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# --- OpenAI -------------------------------------------------------------
# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- RAG ----------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3

# Cosine similarity floor below which a chunk is treated as irrelevant.
# Calibrated for text-embedding-3-small: unrelated short English passages
# typically score 0.15-0.30, so 0.35 is a sensible default noise floor.
# Lower values are more permissive (more false positives, more hallucination
# risk); higher values reject more queries with the "not in document" sentinel.
SIMILARITY_THRESHOLD=0.35

# --- Limits -------------------------------------------------------------
# Max upload size in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760
